# OctoFit Tracker Frontend Environment Variables
# Copy this file to .env.local and update the values

# Codespaces configuration
# If running in GitHub Codespaces, set this to your codespace name
# Format: your-repo-name-{random-hash}
# Example: skills-build-applications-w-copilot-agent-mode-xr7q6g5p
VITE_CODESPACE_NAME=your-codespace-name

# API Configuration
# The API base URL will be constructed automatically:
# - If VITE_CODESPACE_NAME is set: https://${VITE_CODESPACE_NAME}-8000.app.github.dev
# - Otherwise: http://localhost:8000
